    <!-- Fontes Google Fonts: Cinzel e Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg-dark: #120D0A;
            --bg-card: #1E1611;
            --bg-section: #17110D;
            --gold: #E5A93B;
            --gold-hover: #F5C056;
            --terracotta: #C84B31;
            --ochre: #D97724;
            --text-light: #F7F3EE;
            --text-muted: #C4B8AE;
            --border-subtle: rgba(229, 169, 59, 0.25);
            --font-display: 'Cinzel', serif;
            --font-body: 'Plus Jakarta Sans', sans-serif;
            --transition: all 0.35s cubic-bezier(0.25, 0.8, 0.25, 1);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background-color: var(--bg-dark);
            color: var(--text-light);
            font-family: var(--font-body);
            line-height: 1.7;
            overflow-x: hidden;
        }

        .african-pattern-bar {
            height: 10px;
            width: 100%;
            background: repeating-linear-gradient(
                90deg,
                var(--gold) 0px, var(--gold) 25px,
                var(--terracotta) 25px, var(--terracotta) 50px,
                var(--bg-dark) 50px, var(--bg-dark) 60px,
                var(--ochre) 60px, var(--ochre) 85px
            );
        }

        header {
            background-color: rgba(18, 13, 10, 0.95);
            backdrop-filter: blur(10px);
            position: sticky;
            top: 0;
            z-index: 1000;
            border-bottom: 1px solid var(--border-subtle);
        }

        .nav-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 1rem 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .logo {
            font-family: var(--font-display);
            font-size: 1.3rem;
            font-weight: 800;
            color: var(--gold);
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            cursor: pointer;
        }

        .logo span {
            background-color: var(--terracotta);
            color: var(--text-light);
            font-family: var(--font-body);
            font-size: 0.75rem;
            padding: 0.2rem 0.5rem;
            border-radius: 4px;
            letter-spacing: 1px;
        }

        .nav-links { display: flex; gap: 0.5rem; flex-wrap: wrap; }

        .nav-btn {
            background: transparent;
            border: 1px solid transparent;
            color: var(--text-muted);
            font-family: var(--font-body);
            font-size: 0.85rem;
            font-weight: 600;
            padding: 0.45rem 0.85rem;
            border-radius: 6px;
            cursor: pointer;
            transition: var(--transition);
        }

        .nav-btn:hover, .nav-btn.active {
            color: var(--gold);
            background: rgba(229, 169, 59, 0.1);
            border-color: var(--border-subtle);
        }

        .page-view { display: none; animation: fadeInPage 0.5s ease forwards; }
        .page-view.active { display: block; }

        @keyframes fadeInPage {
            from { opacity: 0; transform: translateY(15px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .container { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }

        .hero {
            padding: 4rem 0;
            border-bottom: 1px solid var(--border-subtle);
            background: radial-gradient(circle at top right, rgba(200, 75, 49, 0.15), transparent 50%),
                        radial-gradient(circle at bottom left, rgba(229, 169, 59, 0.1), transparent 50%);
        }

        .hero-grid { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 3rem; align-items: center; }

        .date-badge {
            display: inline-block;
            background-color: var(--terracotta);
            color: var(--text-light);
            font-weight: 700;
            font-size: 0.9rem;
            padding: 0.4rem 1rem;
            border-radius: 50px;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            margin-bottom: 1rem;
            box-shadow: 0 4px 15px rgba(200, 75, 49, 0.3);
        }

        .hero h1 {
            font-family: var(--font-display);
            font-size: clamp(2.4rem, 5vw, 3.8rem);
            line-height: 1.15;
            color: var(--gold);
            margin-bottom: 1.5rem;
        }

        .hero-text p { color: var(--text-muted); font-size: 1.05rem; margin-bottom: 1.2rem; text-align: justify; }

        .hero-image-box {
            position: relative;
            border-radius: 16px;
            overflow: hidden;
            border: 2px solid var(--gold);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
        }

        .hero-image-box img { width: 100%; height: 440px; object-fit: cover; display: block; transition: transform 0.6s ease; }
        .hero-image-box:hover img { transform: scale(1.03); }

        .image-caption {
            background: linear-gradient(transparent, rgba(18, 13, 10, 0.95));
            position: absolute; bottom: 0; left: 0; right: 0;
            padding: 2rem 1.2rem 1rem; font-size: 0.85rem; color: var(--gold); font-weight: 500;
        }
    </style>
</head>
<body>
    <div class="african-pattern-bar"></div>

    <header>
        <div class="nav-container">
            <a class="logo" onclick="navigateTo('home')">
                CONSCIÊNCIA NEGRA <span>20 NOV</span>
